{
  "format": "oot3d_native_game_launch_profile_v1",
  "arguments": [
    "--a32-process-manifest",
    "${profile_dir}/process-manifest.json",
    "--resource-root",
    "${profile_dir}/resources",
    "--renderer",
    "nri",
    "--ui-profile",
    "topscreen",
    "--topscreen-config",
    "${profile_dir}/topscreen_ui.json",
    "--topscreen-texture-overrides",
    "${profile_dir}/atlas_overrides.o3tu",
    "--save-data",
    "${profile_dir}/savedata",
    "--gameplay-timing",
    "native30_no_interpolation",
    "--presentation-rate",
    "30",
    "--width",
    "1280",
    "--height",
    "720"
  ]
}
