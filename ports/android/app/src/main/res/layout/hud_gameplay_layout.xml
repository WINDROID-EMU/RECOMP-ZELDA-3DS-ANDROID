<?xml version="1.0" encoding="utf-8"?>
<!--
    TriAevum - The Legend of Zelda: Ocarina of Time 3D
    Gameplay HUD Visual Layout (Editor / Preview)
    
    Abra este arquivo no Android Studio na aba "Design" para visualizar,
    arrastar, redimensionar e reposicionar os elementos do HUD livremente!
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hud_root_canvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1C23"
    android:keepScreenOn="true"
    tools:ignore="ContentDescription,HardcodedText,RtlHardcoded">

    <!-- ================================================================= -->
    <!-- CANTO SUPERIOR ESQUERDO: VIDA (CORAÇÕES) & MAGIA                  -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/hud_top_left_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="72dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Linha 1 de Corações -->
        <LinearLayout
            android:id="@+id/hud_hearts_row_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/hud_heart" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/hud_heart" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/hud_heart" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/hud_heart" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/hud_heart" />
        </LinearLayout>

        <!-- Barra de Magia -->
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- CANTO INFERIOR ESQUERDO: CONTADOR DE RÚPIAS & CHAVES             -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!-- CANTO SUPERIOR DIREITO: GRUPO PRINCIPAL DE BOTÕES (HUD)           -->
    <!-- ================================================================= -->

    <!-- ================================================================= -->
    <!-- CANTO INFERIOR DIREITO: MINIMAPA                                  -->
    <!-- ================================================================= -->

    <LinearLayout
        android:id="@+id/hud_bottom_left_collectibles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="13dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Ícone da Rúpia Verde -->
        <ImageView
            android:id="@+id/hud_rupee_icon"
            android:layout_width="20dp"
            android:layout_height="28dp"
            android:src="@drawable/hud_rupee" />

        <!-- Quantidade de Rúpias -->
        <TextView
            android:id="@+id/hud_rupee_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="42"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/hud_top_right_action_cluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="15dp"
        android:layout_marginRight="21dp">

        <!-- BOTÃO B (ESPADA) - Círculo Prateado 52x52 dp -->
        <RelativeLayout
            android:id="@+id/hud_btn_b"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:background="@drawable/hud_button_ring">

            <!-- Distintivo Amarelo 'B' -->
            <TextView
                android:id="@+id/badge_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/hud_badge_yellow"
                android:text="B"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Ícone da Espada -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="⚔"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />
        </RelativeLayout>

        <!-- BOTÃO A (AÇÃO) - Círculo Prateado IDÊNTICO AO BOTÃO B (52x52 dp) -->
        <!-- Posicionado diretamente ao lado do Botão B -->
        <RelativeLayout
            android:id="@+id/hud_btn_a"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="14dp"
            android:layout_toRightOf="@id/hud_btn_b"
            android:background="@drawable/hud_button_ring">

            <!-- Distintivo Amarelo 'A' no topo do anel -->
            <TextView
                android:id="@+id/badge_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:background="@drawable/hud_badge_yellow"
                android:text="A"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Texto de Ação Contextual (Check / Open / Speak / Attack) -->
            <TextView
                android:id="@+id/text_hud_a_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginTop="4dp"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text="Check"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- ============================================================= -->
        <!-- CLUSTER DE ITENS EM LOSANGO (DIAMOND: X, Y, ZR, ZL)           -->
        <!-- ============================================================= -->
        <RelativeLayout
            android:id="@+id/hud_diamond_cluster"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginLeft="16dp"
            android:layout_toRightOf="@id/hud_btn_a">

            <!-- BOTÃO X (Topo do Losango) -->
            <RelativeLayout
                android:id="@+id/hud_btn_x"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/hud_button_ring">

                <TextView
                    android:id="@+id/badge_x"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/hud_badge_yellow"
                    android:text="X"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="🏹"
                    android:textSize="20sp" />

                <!-- Contador de Munição -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:background="#CC000000"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:text="40"
                    android:textColor="#00FF66"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- BOTÃO Y (Esquerda do Losango) -->
            <RelativeLayout
                android:id="@+id/hud_btn_y"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:background="@drawable/hud_button_ring">

                <TextView
                    android:id="@+id/badge_y"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/hud_badge_yellow"
                    android:text="Y"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="🌰"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:background="#CC000000"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:text="40"
                    android:textColor="#00FF66"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- BOTÃO ZR (Direita do Losango) -->
            <RelativeLayout
                android:id="@+id/hud_btn_zr"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/hud_button_ring">

                <TextView
                    android:id="@+id/badge_zr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/hud_badge_yellow"
                    android:text="ZR"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="🗺"
                    android:textSize="20sp" />
            </RelativeLayout>

            <!-- BOTÃO ZL (Base do Losango) -->
            <RelativeLayout
                android:id="@+id/hud_btn_zl"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="@drawable/hud_button_ring">

                <TextView
                    android:id="@+id/badge_zl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/hud_badge_yellow"
                    android:text="ZL"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="💣"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentBottom="true"
                    android:background="#CC000000"
                    android:paddingLeft="2dp"
                    android:paddingRight="2dp"
                    android:text="50"
                    android:textColor="#00FF66"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/hud_minimap_container"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/hud_minimap_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="▲"
            android:textColor="#FFEB3B"
            android:textSize="18sp" />
    </RelativeLayout>

</RelativeLayout>
