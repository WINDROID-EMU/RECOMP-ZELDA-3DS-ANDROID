<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0E14"
    android:padding="8dp">

    <!-- Top Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:paddingTop="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_config_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙ TriAevum — Configurações"
                android:textColor="#FFC107"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_config_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snapdragon 870 / Adreno 650 · Android 12"
                android:textColor="#8B9BB4"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_config_restore"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_danger"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="Restaurar Padrões"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_config_save"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:background="@drawable/btn_gold"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Salvar"
                android:textColor="#1A1500"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_config_close"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/btn_dark"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Fechar"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2836"
        android:layout_marginBottom="6dp" />

    <!-- Main Content: Left Tabs + Right Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Tab Navigation -->
        <ScrollView
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:background="@drawable/card_bg"
            android:padding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/tab_geral"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🌐  Geral"
                    android:textColor="#FFD700"
                    android:background="@drawable/tab_selected_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_graficos"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🎨  Gráficos"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_camera"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="📷  Câmera / HUD"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />

                <Button
                    android:id="@+id/tab_controles"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="3dp"
                    android:text="🎮  Controles"
                    android:textColor="#8B9BB4"
                    android:background="@drawable/btn_dark"
                    android:textSize="12sp"
                    android:gravity="center_vertical|left"
                    android:paddingLeft="12dp" />
            </LinearLayout>
        </ScrollView>

        <View android:layout_width="6dp" android:layout_height="match_parent" />

        <!-- Right Panel Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- Panel: Geral -->
            <ScrollView
                android:id="@+id/panel_geral"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Idioma -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IDIOMA DO JOGO"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/sp_language"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_dark"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                    <!-- Resolução de Superfície -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIMITE DE RESOLUÇÃO DE SUPERFÍCIE"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Define o limite da superfície de renderização Vulkan. 720p = padrão; 1080p = nativo Moto G100."
                            android:textColor="#8B9BB4"
                            android:textSize="10sp"
                            android:layout_marginBottom="8dp" />

                        <Spinner
                            android:id="@+id/sp_surface_resolution"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/btn_dark"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Gráficos -->
            <ScrollView
                android:id="@+id/panel_graficos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Renderização -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RENDERIZAÇÃO"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Escala de Renderização"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_render_scale"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Anti-Aliasing"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_aa_mode"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Taxa de Quadros"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <Spinner android:id="@+id/sp_framerate"
                                android:layout_width="140dp" android:layout_height="36dp"
                                android:background="@drawable/btn_dark" android:paddingLeft="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sincronização & Texturas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SINCRONIZAÇÃO E TEXTURAS"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="VSync"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_vsync"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Texturas Customizadas"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_custom_textures"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Câmera / HUD -->
            <ScrollView
                android:id="@+id/panel_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Câmera Livre -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CÂMERA LIVRE (C-STICK)"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="10dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Câmera Livre Ativada"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_free_camera"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_cam_speed_label"
                            android:text="Velocidade: 3"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_cam_speed"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="4" android:progress="2"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Inverter Eixo X"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_cam_invert_x"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Inverter Eixo Y"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_cam_invert_y"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- HUD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HUD"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_hud_scale_label"
                            android:text="Escala HUD: 80%"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="4dp" />
                        <SeekBar android:id="@+id/sb_hud_scale"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="10" android:progress="3"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Minimapa Visível"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_minimap"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Ícones no D-Pad"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_dpad_icons"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Panel: Controles -->
            <ScrollView
                android:id="@+id/panel_controles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <!-- Overlay Virtual -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVERLAY VIRTUAL"
                            android:textColor="#FFC107"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="6dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Exibir Controles na Tela"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_show_overlay"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:id="@+id/tv_opacity_label"
                            android:text="Opacidade dos Controles: 100%"
                            android:textColor="#8B9BB4" android:textSize="11sp" android:layout_marginBottom="2dp" />
                        <SeekBar android:id="@+id/sb_overlay_opacity"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:max="100" android:progress="100"
                            android:progressTint="#FFD700" android:thumbTint="#FFC107"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Feedback Háptico / Vibração"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_haptic"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Inverter Telas (Superior/Inferior)"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_swap_screens"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="5dp">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Centro Relativo do Analógico"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_joystick_rel_center"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:text="Deslize no D-Pad"
                                android:textColor="#C8D8E8" android:textSize="12sp" android:layout_gravity="center_vertical" />
                            <CheckBox android:id="@+id/cb_dpad_slide"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:buttonTint="#FFD700" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>
    </LinearLayout>

</LinearLayout>
